# Copy thanh local/.env (bi .gitignore). Chi dung cho lab local - password mac dinh yeu.

MONGO_VERSION=8.0
# IP/host ma CA container LAN client tren may ban deu toi duoc cac port da publish.
# Docker trong WSL: chay `hostname -I` trong WSL, lay IP dau tien (IP doi sau moi lan restart WSL,
# xem muc "IP WSL doi" trong docs/01-local-docker.md). Docker Desktop/Linux: IP LAN cua may.
MONGO_HOST=192.168.1.10

ADMIN_USER=admin
ADMIN_PASSWORD=admin_pass
SYNC_USER=mongosync
SYNC_PASSWORD=mongosync_pass

SRC_RS=src-rs
SRC_PORT_1=27017
SRC_PORT_2=27018
SRC_PORT_3=27019

DST_RS=dst-rs
DST_PORT_1=27027
DST_PORT_2=27028
DST_PORT_3=27029
