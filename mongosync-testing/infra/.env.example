# Bien moi truong cho Terragrunt (docs/02-gcp-infra.md §2.4).
#   cp infra/.env.example infra/.env && chmod 600 infra/.env   # infra/.env bi .gitignore
#   source infra/.env                                           # chay lai moi khi mo terminal moi
# Chi ID va secret nam o day; cau hinh ha tang nam trong infra/live/{gcp,atlas}/values.yaml.

# ===== GCP (bat buoc cho moi huong) =====
# Project tao o §2.2 (gcloud projects create ...). Terraform dung credential cua
# `gcloud auth application-default login`, khong can key file.
export GCP_PROJECT_ID=""

# ===== Atlas (chi huong B - M10 va C - M0) =====
# Organization Settings -> Organization ID
export ATLAS_ORG_ID=""
# Organization Settings -> Access Manager -> API Keys (nho them IP may ban vao API Access List)
export MONGODB_ATLAS_PUBLIC_KEY=""
export MONGODB_ATLAS_PRIVATE_KEY=""

# ===== Tuy chon =====
# (C) Them IP may ban vao whitelist M0 de dung Compass/mongosh tu may local. De trong = chi IP NAT.
#   export MY_PUBLIC_IP="$(curl -s https://checkip.amazonaws.com)"
export MY_PUBLIC_IP=""

# Provider cache cua Terragrunt: tai provider 1 lan dung chung cho moi unit, an toan khi `run --all`
# chay song song. (Khong dung TF_PLUGIN_CACHE_DIR: init song song se loi checksum.)
export TG_PROVIDER_CACHE=1

# Kiem tra nhanh: bao loi neu quen dien bien bat buoc
[ -n "$GCP_PROJECT_ID" ] || echo "WARN: GCP_PROJECT_ID dang trong (sua infra/.env)" >&2
