# systemd unit de chay mongosync nhu 1 service (tuy chon - guide mac dinh chay trong tmux).
#   sudo cp mongosync.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl start mongosync && journalctl -u mongosync -f
# Process tu resume tu metadata tren destination sau khi restart => Restart=on-failure an toan.
[Unit]
Description=mongosync (lab)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/mongosync --config /etc/mongosync/config.yaml
Restart=on-failure
RestartSec=10
LimitNOFILE=64000

[Install]
WantedBy=multi-user.target
