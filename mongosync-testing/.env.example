# ===== MongoDB clusters (docker compose) — chi dung cho test/dev =====
MONGO_VERSION=8.0
# Host/IP ma CA container LAN client (Compass, mongosync, generator) deu ket noi duoc toi cac port da publish.
# WSL: lay bang `wsl hostname -I` (IP doi sau moi lan restart WSL => sua day roi chay lai *-init, xem README).
MONGO_HOST=192.168.240.36
ADMIN_USER=admin
ADMIN_PASSWORD=admin_pass
SYNC_USER=mongosync
SYNC_PASSWORD=mongosync_pass

# Container mongosync: ssh root@localhost -p BOX_SSH_PORT
BOX_SSH_PORT=2222
BOX_PASSWORD=mongosync

SRC_RS=src-rs
SRC_PORT_1=27017
SRC_PORT_2=27018
SRC_PORT_3=27019

DST_RS=dst-rs
DST_PORT_1=27027
DST_PORT_2=27028
DST_PORT_3=27029

# ===== Data generator (generator-node / generator-go) =====
# src | dst | custom (custom => dung MONGO_URI)
TARGET=src
# De trong = tu build URI 3 node tu MONGO_HOST + ports + RS. Dat gia tri de override.
MONGO_URI=

DB_COUNT=3
DB_PREFIX=synctest_db
COLLECTIONS_PER_DB=5
COLL_PREFIX=coll
DOCS_PER_COLLECTION=10000
# Dung luong muc tieu (BSON dataSize) moi DB, MB. 0 = khong padding.
# Kich thuoc doc = TARGET_MB_PER_DB / (COLLECTIONS_PER_DB * DOCS_PER_COLLECTION). So doc la chinh.
TARGET_MB_PER_DB=50
INDEXES_PER_COLLECTION=2
BATCH_SIZE=1000
CONCURRENCY=4
# true = drop collection cu truoc khi insert
DROP_EXISTING=true
# De trong = random moi lan; dat so de tai lap du lieu
SEED=
