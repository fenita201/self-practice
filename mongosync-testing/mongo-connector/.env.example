# ===== Ket noi (mac dinh: cluster SOURCE, URL 3 node qua MONGO_HOST cua ../.env) =====
MONGO_URI=mongodb://admin:admin_pass@192.168.240.36:27017,192.168.240.36:27018,192.168.240.36:27019/?replicaSet=src-rs&authSource=admin

# ===== Toc do (so operation / giay). 0 = tat =====
READ_RATE=100
WRITE_RATE=20
# % cua WRITE_RATE la update doc co san (con lai la insert doc moi)
WRITE_UPDATE_PERCENT=30
# So doc doc moi lan read
READ_BATCH_SIZE=1
# Kich thuoc truong payload cua doc insert (bytes)
WRITE_PAYLOAD_BYTES=256

# ===== Chon DB / collection =====
# Bo qua admin/local/config va system.*. De trong = lay het. Regex JS, vd: ^synctest_db
DB_INCLUDE_REGEX=
COLLECTION_INCLUDE_REGEX=
# collection = chon deu tren toan bo collection | db = chon DB truoc roi collection trong DB do
PICK_BY=collection
# Quet lai danh sach DB/collection moi N giay (thay DB/coll moi tao). 0 = chi quet luc start
DISCOVERY_REFRESH_SEC=30

# ===== Khac =====
# So op toi da dang chay cung luc; vuot qua se bi drop (hien thi trong thong ke)
MAX_INFLIGHT=200
STATS_INTERVAL_SEC=5
# 0 = chay den khi Ctrl+C
RUN_SECONDS=0
