# Copy thanh tools/.env roi sua. File .env bi .gitignore - dung ghi password that vao .env.example.
# Password trong URI phai URL-encode (@ -> %40, : -> %3A ...).

# ===== Ket noi =====
# Cluster NGUON (3 VM src-rs tren GCP; local Docker xem docs/01-local-docker.md)
SRC_URI=mongodb://admin:<SRC_ADMIN_PASSWORD>@10.20.0.11:27017,10.20.0.12:27017,10.20.0.13:27017/?replicaSet=src-rs&authSource=admin
# Cluster DICH - chon 1:
#   VM dst-rs : mongodb://admin:<DST_ADMIN_PASSWORD>@10.20.0.21:27017,10.20.0.22:27017,10.20.0.23:27017/?replicaSet=dst-rs&authSource=admin
#   Atlas M10 : mongodb+srv://mongosync:<PASSWORD>@<lab-m10-pri.xxxxx.mongodb.net>/?authSource=admin
#   Atlas M0  : mongodb+srv://lab_app:<PASSWORD>@<lab-m0.xxxxx.mongodb.net>/?authSource=admin
DST_URI=mongodb://admin:<DST_ADMIN_PASSWORD>@10.20.0.21:27017,10.20.0.22:27017,10.20.0.23:27017/?replicaSet=dst-rs&authSource=admin

# ===== Generator (npm run generate | stats | clean) =====
# Ghi vao cluster nao: src | dst
GEN_TARGET=src
DB_COUNT=3
DB_PREFIX=synctest_db
COLLECTIONS_PER_DB=5
COLL_PREFIX=coll
DOCS_PER_COLLECTION=10000
# Dung luong muc tieu (BSON dataSize) moi DB, MB. 0 = khong padding.
# Kich thuoc doc ~= TARGET_MB_PER_DB / (COLLECTIONS_PER_DB * DOCS_PER_COLLECTION). So doc duoc uu tien.
TARGET_MB_PER_DB=50
INDEXES_PER_COLLECTION=2
BATCH_SIZE=1000
CONCURRENCY=4
# true = drop collection cu truoc khi insert (false = chay lai se ghi them doc, khong trung _id)
DROP_EXISTING=true
# De trong = random moi lan; dat so de tai lap dung du lieu
SEED=

# ===== Connector - app gia lap doc/ghi lien tuc (npm run connector) =====
# Doc/ghi vao cluster nao: src | dst
CONNECTOR_TARGET=src
# Tuy chon: URI rieng cho connector, uu tien hon CONNECTOR_TARGET. Dung user KHONG phai root
# (vd readWriteAnyDatabase) de thay duoc write blocking cua mongosync - root duoc bypass.
CONNECTOR_URI=
# So operation / giay. 0 = tat
READ_RATE=100
WRITE_RATE=20
# % cua WRITE_RATE la update doc co san (con lai la insert doc moi)
WRITE_UPDATE_PERCENT=30
READ_BATCH_SIZE=1
WRITE_PAYLOAD_BYTES=256
# Bo qua admin/local/config, system.* va DB noi bo cua mongosync. Regex JS, vd: ^synctest_db
DB_INCLUDE_REGEX=
COLLECTION_INCLUDE_REGEX=
# collection = chon deu tren moi collection | db = chon DB truoc roi collection trong DB do
PICK_BY=collection
# Quet lai danh sach DB/collection moi N giay. 0 = chi quet luc start
DISCOVERY_REFRESH_SEC=30
# So op dang chay cung luc toi da (moi loai read/write); vuot qua => drop (co dem trong thong ke)
MAX_INFLIGHT=50
STATS_INTERVAL_SEC=5
# 0 = chay den khi Ctrl+C
RUN_SECONDS=0

# ===== Compare (npm run compare) =====
# Chi so sanh DB khop regex (de trong = tat ca DB khong phai he thong)
COMPARE_DB_REGEX=
# true = them dbHash (md5 noi dung tung collection). Chinh xac nhat nhung cham va can quyen dbHash.
HASH=false
