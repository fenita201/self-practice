{
  "name": "codex-remote-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "set-password": "tsx scripts/password.ts",
    "doctor": "tsx scripts/doctor.ts",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "backup": "tsx scripts/backup.ts",
    "journal:recover": "tsx scripts/journal-recover.ts",
    "format:check": "prettier --check 'src/server/*.ts' 'src/client/*.{tsx,css,html}' 'src/shared/{timeline,drafts}.ts' 'scripts/*.ts' 'tests/**/*.ts' '*.json' '*.ts'"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.5",
    "@uiw/react-codemirror": "4.25.12",
    "chokidar": "5.0.0",
    "dotenv": "18.0.6",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
